# Server Configuration
SERVER_PORT=8084
APPLICATION_NAME=PaymentService

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/payment_service_db
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JPA/Hibernate Settings
SHOW_SQL=false
FORMAT_SQL=true

# Liquibase Configuration
LIQUIBASE_CHANGE_LOG=classpath:/db/changelog/db.changelog-master.yaml
LIQUIBASE_ENABLED=true

# External Services Configuration
USER_SERVICE_URL=http://localhost:8080
USER_SERVICE_API_KEY=internal-auth-key-12345
ORDER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_API_KEY=internal-auth-key-12345

# Feign Client Configuration
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=5000
FEIGN_LOGGER_LEVEL=full

# JWT Configuration (Path to public key)
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# Logging Configuration
LOG_SQL=DEBUG

# Resilience4j Circuit Breaker Configuration (Optional, if using)
RESILIENCE4J_CIRCUITBREAKER_SLIDING_WINDOW_SIZE=10
RESILIENCE4J_CIRCUITBREAKER_MINIMUM_CALLS=5
RESILIENCE4J_CIRCUITBREAKER_PERMITTED_CALLS_HALF_OPEN=3
RESILIENCE4J_CIRCUITBREAKER_AUTO_TRANSITION=true
RESILIENCE4J_CIRCUITBREAKER_WAIT_DURATION=10s
RESILIENCE4J_CIRCUITBREAKER_FAILURE_RATE_THRESHOLD=50

# Management Endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Spring Specific
SPRING_MAIN_ALLOW_BEAN_DEFINITION_OVERRIDING=true
SPRING_AOP_AUTO=true
SPRING_CLOUD_OPENFEIGN_CIRCUITBREAKER_ENABLED=false

KAFKA_BOOTSTRAP_SERVERS=localhost:9093